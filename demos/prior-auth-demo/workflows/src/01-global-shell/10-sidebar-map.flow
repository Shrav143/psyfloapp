title: Global shell › Sidebar › Where every item goes
route: Every page (sidebar on the left)
intro: The sidebar is on every page. Each row below is one click and the page it opens. Number bubbles, opening and closing the Authorizations group, and the green highlight have their own diagrams.
dir: LR
also: The logo 'psyflo.', the caption 'Prior auth & UR', the captions 'Main' and 'Connections' and the 'Demo data' tile are labels only. Nothing happens when they are clicked.
---
start s1 "Any page is open"
screen sb "Sidebar\nLogo, then Main, Connections and the footer"

group gFoot "Footer"
  click cSet "Click 'Settings'"
  process pSet "Go to /settings"
  goto gSet "Continues in: Settings"

  click cHelp "Click 'Help'"
  click cOut "Click 'Sign out'"
  goto gFoot2 "Continues in: Global shell › Sidebar footer › Settings, Help, Sign out, user card"
endgroup

group gConn "Connections"
  click cEmr "Click 'EMR Connect'"
  process pEmr "Go to /emr"
  goto gEmr "Continues in: EMR Connect"

  click cPay "Click 'Payers'"
  process pPay "Go to /payers"
  goto gPay "Continues in: Payers › Workspace"
endgroup

group gMain "Main"
  click cDash "Click 'Dashboard'"
  process pDash "Go to /dashboard"
  goto gDash "Continues in: Dashboard"

  click cAuth "Click 'Authorizations' (the label or the row)"
  process pAuth "Go to /authorizations\nArriving from another page, the worklist reopens the last view and filters used (All the first time); on the worklist itself it shows All with no filters\nFrom outside the group, the group opens"
  goto gAuth "Continues in: Authorizations › Worklist › Arrive and read the views"

  click cArrow "Click the arrow beside 'Authorizations'"
  process pArrow "The sub rows show or hide\nNo page opens"
  goto gArrow "Continues in: Global shell › Sidebar › Authorizations group › Open and close the group"

  click cAll "Click 'All Authorizations'\n(under Authorizations, while the group is open)"
  process pAll "Go to /authorizations\nThe same page, with the same rules, as 'Authorizations'"

  click cNew "Click 'New Case'\n(under Authorizations, while the group is open)"
  process pNew "Go to /authorizations/new\nA blank draft is started"
  goto gNew "Continues in: Authorizations › New Case › How a case starts and resumes"

  click cElig "Click 'Eligibility & Benefits'\n(under Authorizations, while the group is open)"
  process pElig "Go to /authorizations/eligibility"
  goto gElig "Continues in: Authorizations › Eligibility & Benefits"

  click cDen "Click 'Denial Intelligence'"
  process pDen "Go to /denials"
  goto gDen "Continues in: Denial Intelligence"

  click cAna "Click 'Analytics'"
  process pAna "Go to /analytics"
  goto gAna "Continues in: Analytics"
endgroup


s1 --> sb
sb --> cDash & cAuth & cArrow & cAll & cNew & cElig & cDen & cAna & cEmr & cPay & cSet & cHelp & cOut
cDash --> pDash --> gDash
cAuth --> pAuth --> gAuth
cArrow --> pArrow --> gArrow
cAll --> pAll --> gAuth
cNew --> pNew --> gNew
cElig --> pElig --> gElig
cDen --> pDen --> gDen
cAna --> pAna --> gAna
cEmr --> pEmr --> gEmr
cPay --> pPay --> gPay
cSet --> pSet --> gSet
cHelp --> gFoot2
cOut --> gFoot2

  s2 --> t1 --> p1
  s3 --> p2
  s4 --> q1
  q1 -->|"No"| p3
  q1 -->|"Yes"| c2 --> g2
  p3 -.-> q1
  s5 --> e3 --> c3 --> e4
  s6 --> e5 --> g3
  s7 --> e6
  s8 --> e7 --> c4
  c4 --> g5
  s9 --> e8 --> e9 --> g4
  class s1,s2,s3,s4,s5,s6,s7,s8,s9 k_start
  class e1,e2,e3,e5,e7,e8,e9 k_screen
  class c1,c2,c3,c4 k_click
  class g1,g2,g3,g5,g4 k_goto
  class t1 k_toast
  class p1,p2,p3 k_process
  class q1 k_decision
  class e4 k_end
  class e6 k_endx

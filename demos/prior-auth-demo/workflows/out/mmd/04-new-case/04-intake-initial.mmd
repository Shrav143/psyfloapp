%%{init: {"theme":"base","themeVariables":{"fontFamily":"'DM Sans', 'Segoe UI', system-ui, sans-serif","fontSize":"15px","lineColor":"#5B6B63","primaryTextColor":"#1C2B25","clusterBkg":"#FBF8F3","clusterBorder":"#D9CDBB","edgeLabelBackground":"#FFFFFF"},"flowchart":{"curve":"basis","nodeSpacing":36,"rankSpacing":48,"padding":12,"htmlLabels":true,"useMaxWidth":false,"wrappingWidth":230}} }%%
flowchart TD
  classDef k_start fill:#1F5C4B,stroke:#174638,color:#FFFFFF,stroke-width:1.5px,font-weight:600
  classDef k_end fill:#DDEFE3,stroke:#2E7D4F,color:#14502F,stroke-width:1.5px,font-weight:600
  classDef k_endx fill:#FBE3E0,stroke:#C0392B,color:#7A1F16,stroke-width:1.5px,font-weight:600
  classDef k_screen fill:#FFFDF8,stroke:#1F5C4B,color:#1C2B25,stroke-width:2px
  classDef k_overlay fill:#F1F7F3,stroke:#1F5C4B,color:#1C2B25,stroke-width:2px,stroke-dasharray:5 3
  classDef k_click fill:#DCEBFA,stroke:#2F6DB5,color:#12365F,stroke-width:1.5px
  classDef k_input fill:#E4E7FF,stroke:#4C5FD5,color:#1D2670,stroke-width:1.5px
  classDef k_process fill:#EEF0EE,stroke:#7A857F,color:#26302B,stroke-width:1.5px
  classDef k_agent fill:#EEE5FA,stroke:#7A4FC2,color:#341A63,stroke-width:1.5px
  classDef k_decision fill:#FFF0CC,stroke:#D9962B,color:#5C3B00,stroke-width:1.5px
  classDef k_store fill:#D5F0EA,stroke:#1C8E7B,color:#0B4A3F,stroke-width:1.5px
  classDef k_doc fill:#F6E9DC,stroke:#B07A4C,color:#4A2E14,stroke-width:1.5px
  classDef k_ext fill:#FFE6D2,stroke:#E07B39,color:#6B2F06,stroke-width:1.5px
  classDef k_wait fill:#E4E8EE,stroke:#6B7C93,color:#26303D,stroke-width:1.5px
  classDef k_toast fill:#FFF9DB,stroke:#C9A400,color:#5A4A00,stroke-width:1.5px
  classDef k_goto fill:#FFFFFF,stroke:#1F5C4B,color:#1F5C4B,stroke-width:1.5px,stroke-dasharray:5 3
  s1@{ shape: stadium, label: "<b>Open the details</b><br/>After 'Review' on a referral and 'Continue with this referral'<br/>Or 'Create case manually', or a patient picked, or ?referral= or ?verification=" }
  sc@{ shape: curv-trap, label: "<b>Intake · Initial authorization</b><br/>'Start with a referral or a patient. Everything is editable.'<br/>Step header 'STEP 1 OF 5 · Intake' with its state" }
  sFrom@{ shape: curv-trap, label: "<b>One line above the details</b><br/>'From referral RF-2051 · Eastgate Probation Services. Everything below can be changed.'<br/>or 'An existing patient. Their details are filled in and can be changed for this request.'<br/>or 'Created by hand. Add what you know; Reader fills the rest from the chart.'" }
  cDiff@{ shape: trap-t, label: "Click 'Use a different referral or patient'" }
  gStart@{ shape: subproc, label: "Continues in: Authorizations › New case › Intake › Start with a referral or patient" }
  cRef@{ shape: trap-t, label: "Click the referral number in the line" }
  gRef@{ shape: subproc, label: "Continues in: Authorizations › New case › Referral › The full referral page" }
  pPay@{ shape: rect, label: "<b>A case Payers redrafted after a payer change shows one line</b><br/>'Updated for a payer change on 10/20'" }
  sDup@{ shape: curv-trap, label: "<b>One alert at a time</b><br/>'This looks like a request that already exists' (only when one matches)" }
  gDup@{ shape: subproc, label: "Continues in: Authorizations › New case › Intake › Possible duplicate" }
  sSite@{ shape: curv-trap, label: "<b>Site</b><br/>With both sites in view: a 'Site' choice, Site A or Site B<br/>With one site in view: 'Site A · this case is at the site you are working at.'" }
  gSite@{ shape: subproc, label: "Continues in: Authorizations › New case › Sites and scope" }
  subgraph gRows ["The case's details, as rows you can edit"]
  r1@{ shape: curv-trap, label: "<b>Patient</b><br/>'Patient initials and age'" }
  r2@{ shape: curv-trap, label: "<b>Insurance</b><br/>'Payer and plan', 'Member ID' (Recommended)" }
  r3@{ shape: curv-trap, label: "<b>Request</b><br/>'Level of care', 'Request type', 'Start date' (Recommended)" }
  end
  gRows@{ shape: subproc, label: "Continues in: Authorizations › New case › Intake › Patient, insurance and request rows" }
  pType@{ shape: rect, label: "<b>'Request type' offers Initial request and Admission</b><br/>Admission adds 'notice due in about 5 hours'" }
  pEnd@{ shape: rect, label: "<b>'Requested end date' is optional</b><br/>Left empty it asks for the level of care's usual length<br/>'Left empty: the usual 21 days for Residential 3.5, through 11/09/2026.'" }
  subgraph gFoot ["Footer bar, always in view"]
  ft@{ shape: curv-trap, label: "<b>'Save as draft' and 'Continue to Eligibility & Benefits'</b><br/>One hint line" }
  dHint@{ shape: diam, label: "What does the hint say?" }
  h1@{ shape: odd, label: "'A matching request exists. Open it, or continue with a reason.'" }
  h2@{ shape: odd, label: "'Still to add: patient, payer and 1 more. You can go on; Review & submit lists what is missing.'" }
  h3@{ shape: odd, label: "'Nothing is sent to the payer until a clinician signs.'" }
  end
  cSave@{ shape: trap-t, label: "Click 'Save as draft'" }
  tSave@{ shape: odd, label: "<b>'Draft saved'</b><br/>'R-1701 is in Case Manager. Pick it up whenever you like.'" }
  gSave@{ shape: subproc, label: "Continues in: Authorizations › New case › Save as draft and leave" }
  cCont@{ shape: trap-t, label: "Click 'Continue to Eligibility & Benefits'" }
  pGo@{ shape: rect, label: "<b>Moves to step 2</b><br/>Nothing blocks the click" }
  gElig@{ shape: subproc, label: "Continues in: Authorizations › New case › Eligibility & Benefits › Initial authorization" }
  s1 --> sc --> sFrom
  sFrom --> cDiff --> gStart
  sFrom --> cRef --> gRef
  sc --> pPay
  sc --> sDup -.-> gDup
  sc --> sSite -.-> gSite
  sc --> r1 & r2 & r3
  r1 --> gRows
  r2 --> gRows
  r3 --> pType
  r3 --> pEnd
  pType -.-> gRows
  sc --> ft --> dHint
  dHint -->|"Duplicate unanswered"| h1
  dHint -->|"Items open"| h2
  dHint -->|"Nothing open"| h3
  ft --> cSave --> tSave --> gSave
  ft --> cCont --> pGo --> gElig
  class s1 k_start
  class sc,sFrom,sDup,sSite,r1,r2,r3,ft k_screen
  class cDiff,cRef,cSave,cCont k_click
  class gStart,gRef,gDup,gSite,gRows,gSave,gElig k_goto
  class pPay,pType,pEnd,pGo k_process
  class dHint k_decision
  class h1,h2,h3,tSave k_toast
  style gRows fill:#FBF8F3,stroke:#D9CDBB,stroke-width:1.5px,color:#5B6B63
  style gFoot fill:#FBF8F3,stroke:#D9CDBB,stroke-width:1.5px,color:#5B6B63

  s1 --> c1 & c2 & c3 & c4 & c5
  c1 --> p1 --> d1
  d1 -->|"Yes"| t1 --> e1
  d1 -->|"No"| p2 --> d2
  d2 -->|"Yes"| t1
  d2 -->|"No"| t2 --> e2
  c2 --> d3
  d3 -->|"Yes"| t3 --> e4
  d3 -->|"No"| p3 --> p4 --> p5 --> d4
  d4 -->|"Yes"| dc1 --> t4 --> e3
  d4 -->|"No"| t5 --> e4
  c3 --> d5
  d5 -->|"Yes"| t6 --> e6
  d5 -->|"No"| p6 --> p7 --> dc2 --> e5
  c4 --> g1
  c5 --> g2
  class s1 k_start
  class c1,c2,c3,c4,c5 k_click
  class p1,p2,p3,p4,p5,p6,p7 k_process
  class d1,d2,d3,d4,d5 k_decision
  class t1,t2,t3,t4,t5,t6 k_toast
  class e1,e3,e5 k_end

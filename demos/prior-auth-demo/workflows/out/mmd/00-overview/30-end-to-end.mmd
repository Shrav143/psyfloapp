%%{init: {"theme":"base","themeVariables":{"fontFamily":"'DM Sans', 'Segoe UI', system-ui, sans-serif","fontSize":"15px","lineColor":"#5B6B63","primaryTextColor":"#1C2B25","clusterBkg":"#FBF8F3","clusterBorder":"#D9CDBB","edgeLabelBackground":"#FFFFFF"},"flowchart":{"curve":"basis","nodeSpacing":36,"rankSpacing":48,"padding":12,"htmlLabels":true,"useMaxWidth":false,"wrappingWidth":230}} }%%
flowchart TD
  classDef k_start fill:#1F5C4B,stroke:#174638,color:#FFFFFF,stroke-width:1.5px,font-weight:600
  classDef k_end fill:#DDEFE3,stroke:#2E7D4F,color:#14502F,stroke-width:1.5px,font-weight:600
  classDef k_endx fill:#FBE3E0,stroke:#C0392B,color:#7A1F16,stroke-width:1.5px,font-weight:600
  classDef k_screen fill:#FFFDF8,stroke:#1F5C4B,color:#1C2B25,stroke-width:2px
  classDef k_overlay fill:#F1F7F3,stroke:#1F5C4B,color:#1C2B25,stroke-width:2px,stroke-dasharray:5 3
  classDef k_click fill:#DCEBFA,stroke:#2F6DB5,color:#12365F,stroke-width:1.5px
  classDef k_input fill:#E4E7FF,stroke:#4C5FD5,color:#1D2670,stroke-width:1.5px
  classDef k_process fill:#EEF0EE,stroke:#7A857F,color:#26302B,stroke-width:1.5px
  classDef k_agent fill:#EEE5FA,stroke:#7A4FC2,color:#341A63,stroke-width:1.5px
  classDef k_decision fill:#FFF0CC,stroke:#D9962B,color:#5C3B00,stroke-width:1.5px
  classDef k_store fill:#D5F0EA,stroke:#1C8E7B,color:#0B4A3F,stroke-width:1.5px
  classDef k_doc fill:#F6E9DC,stroke:#B07A4C,color:#4A2E14,stroke-width:1.5px
  classDef k_ext fill:#FFE6D2,stroke:#E07B39,color:#6B2F06,stroke-width:1.5px
  classDef k_wait fill:#E4E8EE,stroke:#6B7C93,color:#26303D,stroke-width:1.5px
  classDef k_toast fill:#FFF9DB,stroke:#C9A400,color:#5A4A00,stroke-width:1.5px
  classDef k_goto fill:#FFFFFF,stroke:#1F5C4B,color:#1F5C4B,stroke-width:1.5px,stroke-dasharray:5 3
  s1@{ shape: stadium, label: "A referral arrives<br/>A clinic sends documents, or someone drops them in" }
  ref1@{ shape: div-rect, label: "Referrer sends documents" }
  nc1@{ shape: curv-trap, label: "New case › Referral<br/>Checklist of what is ready and what is missing" }
  rd@{ shape: hex, label: "Reader reads the documents and fills the checklist" }
  d1@{ shape: diam, label: "Is the referral complete and acceptable?" }
  askref@{ shape: trap-t, label: "Ask the referrer<br/>or Decline or Override" }
  nc2@{ shape: curv-trap, label: "New case › Medical records<br/>One checklist for patient, insurance, request, documents" }
  emr@{ shape: div-rect, label: "EMR Connect supplies the chart<br/>Pull from EMR" }
  ver@{ shape: hex, label: "Verify checks coverage and benefits<br/>Eligibility & Benefits" }
  nc3@{ shape: curv-trap, label: "New case › Agents work<br/>Scribe, Criteria, Placement, Integrity, Forecaster ..." }
  d2@{ shape: diam, label: "Does an agent need an answer from you?" }
  ans@{ shape: lean-r, label: "Answer Scribe's question" }
  chance@{ shape: hex, label: "Forecaster shows the approval chance" }
  nc4@{ shape: curv-trap, label: "New case › Review and sign<br/>Nothing goes to the payer until a clinician signs" }
  sign@{ shape: trap-t, label: "Clinician signs<br/>Sign and send" }
  req@{ shape: cyl, label: "Request created<br/>Stage: Received" }
  payer@{ shape: div-rect, label: "Payer receives the request<br/>(demo: simulated)" }
  dash@{ shape: curv-trap, label: "Dashboard<br/>Stage strip: Preparing, Received, Under review, Info requested, Decided today, Appeal or call" }
  w1@{ shape: delay, label: "Payer decides<br/>Time passes (the Demo menu moves the clock)" }
  d3@{ shape: diam, label: "What does the payer decide?" }
  info@{ shape: trap-t, label: "Answer on the Dashboard<br/>Send the information requested" }
  ok@{ shape: stadium, label: "Approved<br/>In Case Manager: reviews are scheduled before the authorization ends" }
  den@{ shape: curv-trap, label: "Denial Intelligence<br/>Where the denial is weak, options with chances" }
  d4@{ shape: diam, label: "Which route?" }
  p2p@{ shape: doc, label: "Peer-to-peer brief and call" }
  app@{ shape: doc, label: "Written appeal, signed and sent" }
  acc@{ shape: trap-t, label: "Accept the denial" }
  d5@{ shape: diam, label: "Overturned?" }
  lost@{ shape: stadium, label: "Denial stands<br/>Recorded and counted in Analytics" }
  ana@{ shape: curv-trap, label: "Analytics<br/>Approval by payer, denial reasons, what helps most" }
  mgr@{ shape: curv-trap, label: "Case Manager<br/>Active cases and Reviews this week" }
  s1 --> ref1 --> nc1 --> rd --> d1
  d1 -->|"Missing items"| askref --> nc1
  d1 -->|"Ready"| nc2
  emr -.-> nc2
  nc2 --> ver --> nc3
  nc3 --> d2
  d2 -->|"Yes"| ans --> chance
  d2 -->|"No"| chance
  chance --> nc4 --> sign --> req --> payer --> dash --> w1 --> d3
  d3 -->|"Needs information"| info --> w1
  d3 -->|"Approved"| ok
  d3 -->|"Denied"| den --> d4
  d4 -->|"Call"| p2p --> d5
  d4 -->|"Appeal"| app --> d5
  d4 -->|"Accept"| acc --> lost
  d5 -->|"Yes"| ok
  d5 -->|"No"| lost
  ok --> mgr
  lost --> ana
  ok --> ana
  class s1 k_start
  class ref1,emr,payer k_ext
  class nc1,nc2,nc3,nc4,dash,den,ana,mgr k_screen
  class rd,ver,chance k_agent
  class d1,d2,d3,d4,d5 k_decision
  class askref,sign,info,acc k_click
  class ans k_input
  class req k_store
  class w1 k_wait
  class ok k_end
  class p2p,app k_doc
  class lost k_endx

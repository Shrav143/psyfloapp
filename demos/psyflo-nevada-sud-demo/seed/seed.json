  "interventions": [
    {
      "code": "MI",
      "name": "Motivational interviewing",
      "dimension": "D4",
      "rationale": "Builds the client's own reasons for change; used when readiness is mixed or after a lapse."
    },
    {
      "code": "CBT-RP",
      "name": "Relapse prevention (CBT)",
      "dimension": "D5",
      "rationale": "Maps high-risk situations and rehearses coping responses; the core skill of Level 2.1."
    },
    {
      "code": "MAT-C",
      "name": "MAT coordination",
